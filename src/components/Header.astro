---
const nav = [
  { label: "How it works", href: "#how" },
  { label: "Guardrails", href: "#guardrails" },
  { label: "Providers", href: "#providers" },
  { label: "MCP", href: "#mcp" },
];
const repo = "https://github.com/nugehs/aiglare";
---

<header
  class="sticky top-0 z-50 border-b border-line bg-paper/85 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="#top" class="flex items-center gap-2.5">
      <img
        src={import.meta.env.BASE_URL + "/logo.svg"}
        alt=""
        width="30"
        height="30"
        class="rounded-lg"
      />
      <span class="font-display text-lg font-bold tracking-tight text-ink"
        >aiglare</span
      >
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-muted transition-colors hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={repo}
        class="hidden text-sm font-medium text-muted transition-colors hover:text-ink sm:inline"
        >GitHub</a
      >
      <a
        href="#install"
        class="inline-flex items-center gap-1.5 rounded-lg bg-ink px-4 py-2 text-sm font-semibold text-paper transition-transform hover:-translate-y-0.5"
      >
        Run an audit
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</header>
