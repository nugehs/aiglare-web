---
interface Props {
  title?: string;
  tone?: "light" | "dark";
  class?: string;
}
const { title = "", tone = "light", class: className = "" } = Astro.props;
const dark = tone === "dark";
---

<div
  class={`overflow-hidden rounded-xl border shadow-xl ${dark ? "border-ink/40 bg-ink shadow-ink/25" : "border-line bg-card shadow-ink/8"} ${className}`}
>
  <div
    class={`flex items-center gap-2 border-b px-4 py-2.5 ${dark ? "border-white/10" : "border-line"}`}
  >
    <span class="h-2.5 w-2.5 rounded-full bg-red"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-amber"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-green"></span>
    {
      title && (
        <span
          class={`ml-2 font-mono text-xs ${dark ? "text-faint" : "text-faint"}`}
        >
          {title}
        </span>
      )
    }
  </div>
  <div class="overflow-x-auto">
    <slot />
  </div>
</div>
