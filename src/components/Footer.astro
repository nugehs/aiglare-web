---
const repo = "https://github.com/nugehs/aiglare";
const cols = [
  {
    title: "Product",
    links: [
      { label: "How it works", href: "#how" },
      { label: "Guardrails", href: "#guardrails" },
      { label: "Providers", href: "#providers" },
      { label: "MCP server", href: "#mcp" },
    ],
  },
  {
    title: "Resources",
    links: [
      { label: "npm package", href: "https://www.npmjs.com/package/@nugehs/aiglare" },
      { label: "GitHub", href: repo },
      { label: "Changelog", href: repo + "/blob/main/CHANGELOG.md" },
      { label: "Pilot guide", href: repo + "/blob/main/PILOT.md" },
    ],
  },
  {
    title: "Ecosystem",
    links: [
      { label: "repoctx", href: "https://github.com/nugehs/repoctx" },
      { label: "Contributing", href: repo + "/blob/main/CONTRIBUTING.md" },
      { label: "Issues", href: repo + "/issues" },
      { label: "License (MIT)", href: repo + "/blob/main/LICENSE" },
    ],
  },
];
---

<footer class="border-t border-line bg-paper-2">
  <div class="mx-auto max-w-6xl px-5 py-14">
    <div class="grid gap-10 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div>
        <a href="#top" class="flex items-center gap-2.5">
          <img
            src={import.meta.env.BASE_URL + "/logo.svg"}
            alt=""
            width="30"
            height="30"
            class="rounded-lg"
          />
          <span class="font-display text-lg font-bold tracking-tight text-ink"
            >aiglare</span
          >
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
          Lint your AI features for governance guardrails. Static, advisory
          analysis — surfaces to review, not violations to trust blindly.
        </p>
      </div>

      {
        cols.map((col) => (
          <div>
            <h4 class="text-xs font-semibold tracking-widest text-faint uppercase">
              {col.title}
            </h4>
            <ul class="mt-4 space-y-2.5">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-muted transition-colors hover:text-iris"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 border-t border-line pt-6 text-sm text-faint">
      <p class="leading-relaxed">
        aiglare is part of a toolchain by
        <a href="https://segunolumbe.com" class="text-muted transition-colors hover:text-iris">Oluwasegun Olumbe</a>
        — <a href="https://nugehs.github.io/repoctx-web/" class="text-muted transition-colors hover:text-iris">repoctx</a> ·
        <a href="https://www.npmjs.com/package/@nugehs/tieline" class="text-muted transition-colors hover:text-iris">tieline</a> ·
        <a href="https://nugehs.github.io/bouncer-web/" class="text-muted transition-colors hover:text-iris">bouncer</a> ·
        aiglare.
        <span class="font-mono text-xs">static analysis, never the model.</span>
      </p>
      <div
        class="mt-4 flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-center"
      >
        <p>© 2026 Oluwasegun Olumbe · MIT licensed.</p>
        <p class="font-mono text-xs">$ npx -y @nugehs/aiglare ./src --ci</p>
      </div>
    </div>
  </div>
</footer>
